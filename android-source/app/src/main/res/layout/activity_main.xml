<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nukera_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".activities.MainActivity">

    <include layout="@layout/app_toolbar" />

    <!-- Center content: hero + status + telegram stacked vertically -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Ambient glow behind hero -->
        <View
            android:id="@+id/hero_ambient_glow"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="-280dp"
            android:background="@drawable/hero_glow_off" />

        <!-- Hero button stack -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/hero_outer_ring"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/hero_outer_ring">

                <FrameLayout
                    android:id="@+id/hero_border_ring"
                    android:layout_width="162dp"
                    android:layout_height="162dp"
                    android:layout_gravity="center"
                    android:background="@drawable/hero_border">

                    <FrameLayout
                        android:id="@+id/status_button_card"
                        android:layout_width="144dp"
                        android:layout_height="144dp"
                        android:layout_gravity="center"
                        android:background="@drawable/hero_core_off"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/status_button_icon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_power"
                            android:contentDescription="@string/vpn_connect"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                </FrameLayout>

            </FrameLayout>

        </FrameLayout>

        <!-- Status text: always below hero button -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/nukera_text"
            android:textSize="16sp"
            android:letterSpacing="0.05"
            tools:text="Disconnected" />

        <!-- Setup Telegram: below status text -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/telegram_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            app:cardCornerRadius="50dp"
            app:cardBackgroundColor="@color/nukera_glass_bg"
            app:strokeColor="@color/nukera_surface_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/setup_telegram"
                android:textSize="15sp"
                android:textColor="@color/nukera_glass_text"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom buttons: optimize + settings -->
    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optimize_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="50dp"
            app:cardBackgroundColor="@color/nukera_glass_bg"
            app:strokeColor="@color/nukera_surface_border"
            app:strokeWidth="1.5dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/optimize_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_speed"
                    android:contentDescription="@string/optimize"
                    app:tint="@color/nukera_glass_text" />

                <TextView
                    android:id="@+id/optimize_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/optimize"
                    android:textSize="14sp"
                    android:textColor="@color/nukera_glass_text"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/optimize_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/optimize_progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/nukera_accent"
                android:progressBackgroundTint="@color/nukera_surface_border" />

            <TextView
                android:id="@+id/optimize_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="12sp"
                android:textColor="@color/nukera_text_dim"
                tools:text="5/51" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/nukera_glass_bg"
            app:strokeColor="@color/nukera_surface_border"
            app:strokeWidth="2dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_settings_24"
                android:contentDescription="@string/title_settings"
                app:tint="@color/nukera_text_dim" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
