#!/usr/bin/env bash
# unblocker.install — pacman install script for the unblocker package.
post_install() {
    # File capabilities for the DPI engine survive pacman overwrites only
    # if re-applied here (fakeroot replaces the file on upgrade).
    if command -v setcap >/dev/null 2>&1 && [ -f /usr/lib/unblocker/nfqws ]; then
        setcap cap_net_admin,cap_net_raw,cap_dac_override,cap_setuid,cap_setgid,cap_setpcap,cap_sys_admin=+ep /usr/lib/unblocker/nfqws 2>/dev/null || true
    fi

    # /etc/systemd/system/unblocker.service shadows this package's unit
    # (which lives in /usr/lib/systemd/system/). Purge any stale file left
    # by the old pre-package install — systemd prefers /etc over /usr/lib.
    rm -f /etc/systemd/system/unblocker.service

    systemctl daemon-reload
    systemctl enable unblocker.service >/dev/null 2>&1 || true

    # Best-effort network tasks. The app works without these; they make
    # it better on the first boot.
    if [ ! -s /etc/unblocker/hostlists/reestr.txt ]; then
        echo "Unblocker: downloading DPI blocklist (reestr)…"
        curl -fL --max-time 120 \
            "https://raw.githubusercontent.com/bol-van/rulist/main/reestr_hostname_resolvable.txt" \
            -o /etc/unblocker/hostlists/reestr.txt 2>/dev/null || echo "Unblocker: reestr download skipped"
    fi
    echo "Unblocker: probing working IPs for your ISP (install-discover)…"
    timeout 240 /usr/bin/unblocker install-discover >/dev/null 2>&1 || echo "Unblocker: IP discovery skipped (offline?) — run 'unblocker install-discover' later"

    update-desktop-database -q 2>/dev/null || true
}

post_upgrade() {
    if command -v setcap >/dev/null 2>&1 && [ -f /usr/lib/unblocker/nfqws ]; then
        setcap cap_net_admin,cap_net_raw,cap_dac_override,cap_setuid,cap_setgid,cap_setpcap,cap_sys_admin=+ep /usr/lib/unblocker/nfqws 2>/dev/null || true
    fi
    # Stale /etc unit from the old non-package install would shadow the
    # updated /usr/lib/systemd/system/unblocker.service. Remove it.
    rm -f /etc/systemd/system/unblocker.service
    systemctl daemon-reload
    update-desktop-database -q 2>/dev/null || true
}

pre_remove() {
    # Stop first so the daemon's SIGTERM handler flushes nft and strips
    # /etc/hosts itself — removal must never leave a broken network.
    systemctl disable --now unblocker.service >/dev/null 2>&1 || true
}

post_remove() {
    # Nuclear fail-safe in case the daemon never ran: kill engine, flush
    # all unblocker nft tables, strip hosts block.
    pkill -9 -x nfqws 2>/dev/null || true
    nft delete table inet unblocker 2>/dev/null || true
    nft delete table inet unblocker_nat 2>/dev/null || true
    if grep -q "# BEGIN unblocker" /etc/hosts 2>/dev/null; then
        sed -i '/# BEGIN unblocker/,/# END unblocker/d' /etc/hosts
    fi
    rm -f /tmp/unblocker.state
}